// PG Fund Manager — clean, professional schema
// Money: Decimal (never floats). History: tenancies preserve assignment history,
// payments are append-only, checkout never destroys financial rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("OWNER") // OWNER | MANAGER
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  payments     Payment[] @relation("PaymentRecordedBy")
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Room {
  id          String      @id @default(cuid())
  number      String
  floor       Int         @default(1)
  roomType    String      @default("SHARED") // SHARED | PRIVATE
  defaultRent Decimal     @default(6500)
  notes       String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  beds        Bed[]
  complaints  Complaint[]

  @@unique([number])
  @@index([floor])
}

model Bed {
  id        String    @id @default(cuid())
  roomId    String
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  slot      Int // 1-based position within the room
  label     String // "A", "B", ...
  isActive  Boolean   @default(true)
  tenancies Tenancy[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([roomId, slot])
}

model Tenant {
  id               String    @id @default(cuid())
  name             String
  phone            String?
  email            String?
  idType           String? // AADHAAR | PAN | DL | PASSPORT | OTHER
  idNumber         String?
  emergencyContact String?
  workplace        String?
  notes            String?
  status           String    @default("ACTIVE") // ACTIVE | NOTICE | CHECKED_OUT
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenancies        Tenancy[]
  payments         Payment[]

  @@index([status])
  @@index([name])
}

model Tenancy {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bedId           String
  bed             Bed          @relation(fields: [bedId], references: [id], onDelete: Restrict)
  startDate       DateTime
  endDate         DateTime? // null => currently living here
  noticeDate      DateTime?
  monthlyRent     Decimal
  securityDeposit Decimal      @default(0)
  dueDay          Int          @default(5) // day of month rent is due (1-28)
  isActive        Boolean      @default(true)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  rentInvoices    RentInvoice[]

  @@index([tenantId])
  @@index([bedId])
  @@index([isActive])
}

model RentInvoice {
  id         String     @id @default(cuid())
  tenancyId  String
  tenancy    Tenancy    @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  period     String // "YYYY-MM"
  dueAmount  Decimal    @default(0)
  paidAmount Decimal    @default(0)
  status     String     @default("DUE") // PAID | PARTIAL | DUE | OVERDUE | WAIVED
  dueDate    DateTime?
  method     String? // method of latest payment
  reference  String? // UTR of latest payment
  paidOn     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  payments   Payment[]

  @@unique([tenancyId, period])
  @@index([period])
  @@index([status])
}

model Payment {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rentInvoiceId String?
  rentInvoice   RentInvoice? @relation(fields: [rentInvoiceId], references: [id], onDelete: SetNull)
  amount        Decimal
  date          DateTime
  method        String       @default("UPI") // UPI | CASH | BANK | CARD | CHEQUE
  reference     String? // UTR / cheque number
  receiptNumber String       @unique
  notes         String?
  reversedAt    DateTime? // soft reverse, never hard-delete money history
  recordedById  String?
  recordedBy    User?        @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([tenantId])
  @@index([date])
  @@index([rentInvoiceId])
}

model Expense {
  id        String   @id @default(cuid())
  date      DateTime
  category  String // FOOD | ELECTRICITY | WATER | MAINTENANCE | SALARY | INTERNET | CLEANING | REPAIR | RENT | OTHER
  amount    Decimal
  vendor    String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([date])
  @@index([category])
}

model Complaint {
  id         String    @id @default(cuid())
  title      String
  roomId     String?
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomLabel  String? // denormalised room number, survives room deletion
  category   String    @default("OTHER") // ELECTRICAL | PLUMBING | CLEANLINESS | INTERNET | FOOD | FURNITURE | OTHER
  priority   String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  status     String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  cost       Decimal?
  notes      String?
  date       DateTime  @default(now())
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([date])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // CREATED | UPDATED | DELETED | IMPORTED | PAYMENT | REVERSED | CHECKOUT | SYSTEM
  entity    String // Room | Tenant | Payment | Expense | Complaint | Import | Settings | Maintenance
  entityId  String?
  details   String? // JSON summary
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String // JSON-encoded value
  updatedAt DateTime @updatedAt
}
